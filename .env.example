# Copy to .env.local to override. Every variable is optional; the values below are the defaults.

# Base URL of the API. The default is the challenge's mock server.
VITE_API_BASE_URL=http://localhost:3000

# Path parameters of the graph endpoint. The mock server accepts any value for these two.
VITE_TENANT_ID=1
VITE_BLUEPRINT_ID=bp_01jk766tckfwx84xjcxazggzyc

# The published API has an extra {blueprint_version_id} path segment. The mock server does not
# and returns 404 when it is present, so leave this empty unless you target the real API.
VITE_BLUEPRINT_VERSION_ID=
